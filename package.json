{
  "name": "arrmate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The friendly control plane for your self-hosted media stack.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "postgres": "^3.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.1",
    "prettier": "^3.8.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
