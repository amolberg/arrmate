# Arrmate local development template. Copy to .env.local or .env.
# Never commit the copied file or place real secrets in source control.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://arrmate:arrmate_dev_password@localhost:5432/arrmate
AUTH_SECRET=replace-with-a-long-random-development-secret
# Stable 32-byte base64 key shared by every Arrmate instance in a deployment.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
# Keep false in production. Local `next dev` enables the role switcher.
ARRMATE_ENABLE_DEV_AUTH=false

# Server-side integration settings. None of these are NEXT_PUBLIC_* values.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=replace-me
SONARR_URL=http://localhost:8989
SONARR_API_KEY=replace-me
RADARR_URL=http://localhost:7878
RADARR_API_KEY=replace-me
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=replace-me
BAZARR_URL=http://localhost:6767
BAZARR_API_KEY=replace-me
SEERR_URL=http://localhost:5055
SEERR_API_KEY=replace-me
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=replace-me
QBITTORRENT_PASSWORD=replace-me

# Optional integrations, not implemented in the first slice.
# HUNTARR_URL=http://localhost:9700
# HUNTARR_API_KEY=replace-me
# LIDARR_URL=http://localhost:8686
# LIDARR_API_KEY=replace-me
# REDIS_URL=redis://localhost:6379

# Keep false unless a future test explicitly opts into local fixtures.
ARRMATE_DEMO_MODE=false
INTEGRATION_REQUEST_TIMEOUT_MS=8000
INTEGRATION_POLL_INTERVAL_MS=15000
LOG_LEVEL=info
LOG_REDACT_SECRETS=true

# Production deployments must use a secret manager or deployment platform secrets.
# API keys and passwords belong in the Vault, never in Git.
ARRMATE_ENV_TEMPLATE=1
